{
  "name": "openclaw-musubi",
  "version": "0.1.0",
  "description": "Musubi memory plane for OpenClaw agents — episodic capture, curated knowledge, and presence-to-presence thoughts with authority-weighted prompt supplements.",
  "type": "module",
  "license": "MIT",
  "author": "Eric Mey <ericmey@gmail.com>",
  "homepage": "https://github.com/ericmey/openclaw-musubi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericmey/openclaw-musubi.git"
  },
  "bugs": {
    "url": "https://github.com/ericmey/openclaw-musubi/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "musubi",
    "memory",
    "ai-agents",
    "plugin",
    "rag",
    "sse",
    "cross-modality"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "dist",
    "src",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "lint:fix": "biome check --write .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "2026.4.19-beta.2",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0",
    "@biomejs/biome": "^2.4.14",
    "@vitest/coverage-v8": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "@sinclair/typebox": "0.34.49"
    }
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "install": {
      "npmSpec": "openclaw-musubi",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.4.19-beta.1"
    },
    "build": {
      "openclawVersion": "2026.4.19-beta.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "packageManager": "npm@10.9.2"
}
